<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>app.pullock.session-agent.development</string>
    <key>BundleProgram</key><string>Contents/Library/LaunchServices/PullockSessionAgent</string>
    <key>ProgramArguments</key>
    <array><string>PullockSessionAgent</string><string>--monitor-health</string></array>
    <key>LimitLoadToSessionType</key><string>Aqua</string>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>10</integer>
    <key>ProcessType</key><string>Interactive</string>
    <key>AssociatedBundleIdentifiers</key><array><string>app.pullock.development</string></array>
</dict>
</plist>
